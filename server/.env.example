# ─── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Comma-separated list of origins allowed to call the API (the React app).
CLIENT_ORIGIN=http://localhost:5173

# Set to true when running behind a reverse proxy / load balancer (Render, Railway, Nginx...)
TRUST_PROXY=false

# ─── Database (required) ──────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/madam-no-case   (run `npm run db:local` or install MongoDB)
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/madam-no-case?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/madam-no-case

# Optional, for `npm run db:local`: path to an existing mongod executable, which skips the automatic download.
# MONGOD_BINARY=C:/path/to/mongodb/bin/mongod.exe

# ─── Authentication (required) ────────────────────────────────────────────
# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: used by `npm run create-admin` when no --email/--password flags are given.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Uploads ──────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=5

# ─── Email notifications for new inquiries (optional) ─────────────────────
# Leave blank to disable. Inquiries are always saved to the database regardless.
# For Gmail, use smtp.gmail.com, port 465, SMTP_SECURE=true and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NOTIFY_EMAIL=akinijsetoyin720@gmail.com
