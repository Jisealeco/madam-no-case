{
  "name": "madam-no-case-server",
  "version": "1.0.0",
  "description": "REST API for Madam No Case Ventures",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=./config --watch-path=./controllers --watch-path=./middleware --watch-path=./models --watch-path=./routes --watch-path=./utils --watch-path=./validators --watch-path=./app.js --watch-path=./server.js server.js",
    "db:local": "node scripts/localMongo.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/createAdmin.js",
    "test:api": "node scripts/apiSmokeTest.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
