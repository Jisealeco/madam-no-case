{
  "name": "madam-no-case",
  "version": "1.0.0",
  "private": true,
  "description": "Madam No Case Ventures website: shortcuts that run the client/ and server/ scripts from the project root",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "db:local": "npm run db:local --prefix server",
    "seed": "npm run seed --prefix server",
    "create-admin": "npm run create-admin --prefix server --",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "test:api": "npm run test:api --prefix server --",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server"
  }
}
