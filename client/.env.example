# Leave empty in development: Vite proxies /api and /uploads to the Express server.
# In production, set this to the API's public URL if the frontend is hosted separately,
# e.g. VITE_API_URL=https://api.madamnocase.com
VITE_API_URL=

# Where the dev proxy forwards /api and /uploads (default http://localhost:5000)
VITE_DEV_API_TARGET=http://localhost:5000
